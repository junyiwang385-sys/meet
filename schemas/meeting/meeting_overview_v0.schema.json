{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "meeting_overview_v0.schema.json",
  "title": "Meeting Overview V0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "meeting_title",
    "overall_topic",
    "executive_summary",
    "chapters",
    "warnings"
  ],
  "properties": {
    "schema_version": {"const": "meeting_overview_v0"},
    "meeting_title": {"type": "string"},
    "overall_topic": {"type": "string"},
    "executive_summary": {"type": "string"},
    "chapters": {
      "type": "array",
      "items": {"$ref": "#/$defs/chapter"}
    },
    "warnings": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "$defs": {
    "chapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "start",
        "end",
        "summary",
        "key_points",
        "turn_ids"
      ],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "start": {"type": "number", "minimum": 0},
        "end": {"type": "number", "minimum": 0},
        "summary": {"type": "string"},
        "key_points": {
          "type": "array",
          "items": {"type": "string"}
        },
        "turn_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1}
        }
      }
    }
  }
}
