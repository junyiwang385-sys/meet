{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "meeting_overview_map_v0.schema.json",
  "title": "Meeting Overview MAP V0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "window_id",
    "time_range",
    "chapters",
    "warnings"
  ],
  "properties": {
    "schema_version": {"const": "meeting_overview_map_v0"},
    "window_id": {"type": "integer", "minimum": 1},
    "time_range": {"$ref": "#/$defs/time_range"},
    "chapters": {
      "type": "array",
      "items": {"$ref": "#/$defs/chapter"}
    },
    "warnings": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "$defs": {
    "time_range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {"type": "number", "minimum": 0},
        "end": {"type": "number", "minimum": 0}
      }
    },
    "chapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "summary",
        "key_points",
        "turn_ids",
        "start",
        "end"
      ],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "summary": {"type": "string"},
        "key_points": {
          "type": "array",
          "items": {"type": "string"}
        },
        "turn_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1}
        },
        "start": {"type": "number", "minimum": 0},
        "end": {"type": "number", "minimum": 0}
      }
    }
  }
}
