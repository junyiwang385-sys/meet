{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "meeting_minutes_v0.schema.json",
  "title": "Meeting Minutes V0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "meeting_title",
    "meeting_type",
    "executive_summary",
    "participants",
    "topics",
    "decisions",
    "action_items",
    "risks",
    "open_questions",
    "warnings"
  ],
  "properties": {
    "schema_version": {"const": "meeting_minutes_v0"},
    "meeting_title": {"type": "string"},
    "meeting_type": {
      "type": "string",
      "enum": ["discussion", "decision", "planning", "review", "training", "other"]
    },
    "executive_summary": {"type": "string"},
    "participants": {
      "type": "array",
      "items": {"$ref": "#/$defs/participant"}
    },
    "topics": {
      "type": "array",
      "items": {"$ref": "#/$defs/topic"}
    },
    "decisions": {
      "type": "array",
      "items": {"$ref": "#/$defs/decision"}
    },
    "action_items": {
      "type": "array",
      "items": {"$ref": "#/$defs/action_item"}
    },
    "risks": {
      "type": "array",
      "items": {"$ref": "#/$defs/fact"}
    },
    "open_questions": {
      "type": "array",
      "items": {"$ref": "#/$defs/fact"}
    },
    "warnings": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["speaker", "start", "end"],
      "properties": {
        "speaker": {"type": "string", "minLength": 1},
        "start": {"type": "number", "minimum": 0},
        "end": {"type": "number", "minimum": 0}
      }
    },
    "evidence_list": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/evidence"}
    },
    "participant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["speaker", "summary", "evidence"],
      "properties": {
        "speaker": {"type": "string", "minLength": 1},
        "summary": {"type": "string"},
        "evidence": {"$ref": "#/$defs/evidence_list"}
      }
    },
    "topic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "summary", "key_points", "evidence"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "summary": {"type": "string"},
        "key_points": {
          "type": "array",
          "items": {"type": "string"}
        },
        "evidence": {"$ref": "#/$defs/evidence_list"}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "evidence"],
      "properties": {
        "decision": {"type": "string", "minLength": 1},
        "evidence": {"$ref": "#/$defs/evidence_list"}
      }
    },
    "action_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task", "owner", "due", "evidence"],
      "properties": {
        "task": {"type": "string", "minLength": 1},
        "owner": {"type": ["string", "null"]},
        "due": {"type": ["string", "null"]},
        "evidence": {"$ref": "#/$defs/evidence_list"}
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "evidence"],
      "properties": {
        "text": {"type": "string", "minLength": 1},
        "evidence": {"$ref": "#/$defs/evidence_list"}
      }
    }
  }
}
