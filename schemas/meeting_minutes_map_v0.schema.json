{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "meeting_minutes_map_v0.schema.json",
  "title": "Meeting Minutes Map V0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "window_id",
    "time_range",
    "participants",
    "topics",
    "decisions",
    "action_items",
    "risks",
    "open_questions",
    "warnings"
  ],
  "properties": {
    "schema_version": {"const": "meeting_minutes_map_v0"},
    "window_id": {"type": "integer", "minimum": 1},
    "time_range": {"$ref": "#/$defs/time_range"},
    "participants": {
      "type": "array",
      "items": {"$ref": "#/$defs/participant"}
    },
    "topics": {
      "type": "array",
      "items": {"$ref": "#/$defs/topic"}
    },
    "decisions": {
      "type": "array",
      "items": {"$ref": "#/$defs/decision"}
    },
    "action_items": {
      "type": "array",
      "items": {"$ref": "#/$defs/action_item"}
    },
    "risks": {
      "type": "array",
      "items": {"$ref": "#/$defs/fact"}
    },
    "open_questions": {
      "type": "array",
      "items": {"$ref": "#/$defs/fact"}
    },
    "warnings": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "$defs": {
    "turn_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1}
    },
    "time_range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {"type": "number", "minimum": 0},
        "end": {"type": "number", "minimum": 0}
      }
    },
    "participant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["speaker", "summary", "turn_ids"],
      "properties": {
        "speaker": {"type": "string", "minLength": 1},
        "summary": {"type": "string"},
        "turn_ids": {"$ref": "#/$defs/turn_ids"}
      }
    },
    "topic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "summary", "key_points", "turn_ids"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "summary": {"type": "string"},
        "key_points": {
          "type": "array",
          "items": {"type": "string"}
        },
        "turn_ids": {"$ref": "#/$defs/turn_ids"}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "turn_ids"],
      "properties": {
        "decision": {"type": "string", "minLength": 1},
        "turn_ids": {"$ref": "#/$defs/turn_ids"}
      }
    },
    "action_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task", "owner", "due", "turn_ids"],
      "properties": {
        "task": {"type": "string", "minLength": 1},
        "owner": {"type": ["string", "null"]},
        "due": {"type": ["string", "null"]},
        "turn_ids": {"$ref": "#/$defs/turn_ids"}
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "turn_ids"],
      "properties": {
        "text": {"type": "string", "minLength": 1},
        "turn_ids": {"$ref": "#/$defs/turn_ids"}
      }
    }
  }
}
