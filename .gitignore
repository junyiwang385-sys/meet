# Python / editor caches
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.DS_Store
._*

# Local environments
.venv*/
.conda*/
.rknn3_v100/
.cache/
.modelscope/

# Secrets / local machine state
.ssh_transfer/
.claude/
.codex/
.agents/

# Model weights, generated artifacts, and build scratch
output/
tmp/
hf_models/
SenseVoiceSmall/
audio/
local_test_results/
lifelog-summarizer-v1/

# Vendored upstream repos checked out locally
rknn3-model-zoo/
rknn3-toolkit/

# Frontend dependencies and build output
frontend/**/node_modules/
frontend/**/dist/

# Runtime logs
*.log

# Generated calibration arrays can be rebuilt and are large.
data/lifelog_quant/dataset_np/

# Large model formats if they appear outside ignored dirs
*.safetensors
*.pt
*.pth
*.onnx
*.rknn
*.weight
*.bin
*.npy
*.gguf

# 评测LLM请求逐次dump(噪声,不追踪;保留RESULTS/结果json)
eval/reports/**/_g*/
eval/reports/**/_llm/
eval/reports/ctx_exp_*/A*/

# eval 中间产物/scratch(生成物,不入库)
eval/_pc_clean/
eval/_pc_full_minutes/
eval/local_rerun/
eval/golden_v2/_pc_*/
eval/transcription/_out/
eval/finetune/_out/
eval/finetune/_data/
# eval 实验报告的逐块 LLM dump(留 RESULTS*.md,丢 scratch)
eval/reports/ctx_exp_*/
eval/reports/chunk_size_g2/*/
eval/reports/batch_g2/*/
eval/reports/a3b_g2/*/
eval/reports/a0_vs_a1/*/
eval/reports/cross_ref/*/
!eval/reports/**/RESULTS*.md
