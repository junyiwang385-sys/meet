        "seg-000426",
        "seg-000428",
        "seg-000437"
      ]
    },
    {
      "title": "大堂后勤与婚礼安排协调",
      "overview": "本次会议重点协调大堂后勤与婚礼安排。核心结论是：若会议因天气或路况推迟，酒店将从定金中扣除部分费用；婚礼定于8月16日在酒店花园举行，建议因天气原因改在室内进行。各方需提前沟通天气及路况，确保活动如期进行。",
      "speaker_ids": [
        "speaker_4",
        "speaker_6"
      ],
      "start_ms": 1343000,
      "end_ms": 1481000,
      "start_ref": "seg-000452",
      "end_ref": "seg-000500",
      "refs": [
        "seg-000452",
        "seg-000486",
        "seg-000499"
      ]
    },
    {
      "title": "婚礼大堂布置与婚庆合作安排",
      "overview": "本次会议明确婚庆公司需提前一周来布置大堂，酒店大堂部负责现场协调与消毒登记工作，新人婚礼费用由新人方承担。双方约定婚庆公司提交方案后，酒店将提前两天完成布置，同时通过赠品提升新人满意度以促进未来复婚。酒店需确保婚礼期间场地安全，避免损坏并做好卫生管理。",
      "speaker_ids": [
        "speaker_2",
        "speaker_4"
      ],
      "start_ms": 1486000,
      "end_ms": 1665000,
      "start_ref": "seg-000501",
      "end_ref": "seg-000559",
      "refs": [
        "seg-000535",
        "seg-000547",
        "seg-000548"
      ]
    },
    {
      "title": "会议小节：活动场地与蛋糕安排讨论",
      "overview": "会议确认活动预计40桌，受疫情影响每桌从原计划10人调整为8人。针对座位安排，讨论采用阶梯式餐桌布局，第一排安排6人、第二排7人，后续排数递增以平均分配40多人，确保人员分散。后勤部将提供蛋糕，由内部糕点师完成象征性赠品，无需外部设计；同时考虑中式面点师培训支持，强调活动期间需避免人员密集聚集。",
      "speaker_ids": [
        "speaker_1",
        "speaker_3",
        "speaker_4"
      ],
      "start_ms": 1665000,
      "end_ms": 1781000,
      "start_ref": "seg-000560",
      "end_ref": "seg-000611",
      "refs": [
        "seg-000564",
        "seg-000586",
        "seg-000596"
      ]
    },
    {
      "title": "大堂部与婚礼筹备协调",
      "overview": "本次会议明确大堂部需落实婚礼蛋糕及赠品优惠执行，同时联合市场部开展宣传工作（含海报、小视频）。财政部门应向市场部和运营部提供额外资金支持。会议要求各部门在婚礼后进行酒店满意度调研并提出改进措施，同时确认婚礼当天婚车停放问题已解决，停车场容量充足。各方确认无其他问题，会议结束。",
      "speaker_ids": [
        "speaker_1",
        "speaker_3",
        "speaker_7"
      ],
      "start_ms": 1782000,
      "end_ms": 1932000,
      "start_ref": "seg-000612",
