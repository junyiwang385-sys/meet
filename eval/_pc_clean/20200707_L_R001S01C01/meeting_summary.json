  "speakers": [
    {
      "speaker_id": "speaker_1",
      "overview": "sp1 作为总经理，主持了月末总结会，指出上月市场情况不佳，确认了当前人员结构问题（特别是服务员过多需裁员），并讨论了即将举行的商务会议（约300人，7月下旬）和婚礼（8月16日）的安排，强调了后勤安全、消毒和人员协调的重要性。",
      "refs": [
        "seg-000008",
        "seg-000351"
      ]
    },
    {
      "speaker_id": "speaker_2",
      "overview": "sp2 作为大堂经理，说明了上月业绩受疫情影响较弱，但有重要客人如开发区项目经理宴请，处理了卫生间漏水投诉并协调后勤部，提出大堂人员配置需灵活应对疫情下客流变化，计划与婚庆公司合作举办婚礼并提供定制化服务，同时负责会议期间的引导和场地安排。",
      "refs": [
        "seg-000215",
        "seg-000377"
      ]
    },
    {
      "speaker_id": "speaker_5",
      "overview": "sp5 作为运营部，计划招聘有经验人员筹备商务会议和婚礼，协调场地安全、灯光和消毒措施，确认会议时间安排，以及与大堂部门合作确保婚礼场地布置和流程顺利。",
      "refs": [
        "seg-000236",
        "seg-000237"
      ]
    },
    {
      "speaker_id": "speaker_6",
      "overview": "sp6 作为行政部，指出公司处于淡季，联系外部人员举办婚礼，强调会议期间安全措施，建议分时段管理大量参会人员，以及婚礼当天需妥善安排婚车停放。",
      "refs": [
        "seg-000120",
        "seg-000313"
      ]
    },
    {
      "speaker_id": "speaker_7",
      "overview": "sp7 作为财务部，要求运营部提供详细财务表，建议与政府工作人员合作提升酒店知名度，提出在商业会议期间加强安全措施，协调后勤部应对天气变化，以及在婚礼后进行客户满意度调查。",
      "refs": [
        "seg-000193",
        "seg-000642"
      ]
    }
