        "seg-000208",
        "seg-000233"
      ]
    },
    {
      "title": "会议时长与后勤安排",
      "overview": "会议确定会议时长为三天。后勤部需在酒店住宿，物资需求量大，sp3提议招募临时服务员补充人员，发放较少工资以应对淡季不稳定性。当前为淡季，人员稳定性不足，价格方面较为便宜。",
      "speaker_ids": [
        "speaker_1",
        "speaker_4"
      ],
      "start_ms": 864000,
      "end_ms": 907000,
      "start_ref": "seg-000264",
      "end_ref": "seg-000283",
      "refs": [
        "seg-000264",
        "seg-000265",
        "seg-000266"
      ]
    },
    {
      "title": "商业会议场地协调与安全安排",
      "overview": "本次会议明确运营部需主动对接政府工作人员参与商业会议，以提升酒店知名度并建立合作关系。会议需由专业团队负责场地协调，确保与行政部门有效对接。行政与后勤部门将重点保障安全，包括大堂专人引导、停车管理及保安秩序维护，避免因会议影响其他客人。安全问题被列为优先事项，需特别注意环境安静以防止干扰。",
      "speaker_ids": [
        "speaker_3",
        "speaker_5",
        "speaker_7"
      ],
      "start_ms": 907000,
      "end_ms": 1052000,
      "start_ref": "seg-000284",
      "end_ref": "seg-000332",
      "refs": [
        "seg-000285",
        "seg-000299",
        "seg-000321"
      ]
    },
    {
      "title": "会场准备与防疫措施讨论",
      "overview": "会议确认需检查会场电路及防疫设施以确保安全，酒店将加强消毒、通风和体温监测。会场安排两名接待人员引导参会者，停车场额外配置两名保安（一名负责停车、一名负责指引）。参会人员分两部分：领导由司机/商务车接送，员工坐大巴；用餐环节将分时段进行，避免300多人聚集导致交叉感染。",
      "speaker_ids": [
        "speaker_1",
        "speaker_5",
        "speaker_6"
      ],
      "start_ms": 1052000,
      "end_ms": 1197000,
      "start_ref": "seg-000333",
      "end_ref": "seg-000391",
      "refs": [
        "seg-000333",
        "seg-000344",
        "seg-000385"
      ]
    },
    {
      "title": "商务会议与婚礼安排讨论",
      "overview": "商务会议确定于七月下旬（23日至26日）举办，若遇暴雨等恶劣天气可推迟一到两天；酒店套餐为住客提供一天三顿饭，非住客仅午餐；定金需支付总金额20%；大堂需预留包间供领导点菜需求。婚礼安排待后续确认具体时间。",
      "speaker_ids": [
        "speaker_4"
      ],
      "start_ms": 1199000,
      "end_ms": 1341000,
      "start_ref": "seg-000392",
      "end_ref": "seg-000451",
