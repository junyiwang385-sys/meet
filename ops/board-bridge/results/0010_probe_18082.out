from pathlib import Path

from meeting_agent.adapters.board import board_agent_api_v0 as api
from meeting_agent.adapters.board import board_harness_worker_v0 as worker
from meeting_agent.adapters.board.board_harness_worker_v0 import HarnessRunConfig as BaseHarnessRunConfig

ROOT = Path("/userdata/meeting_agent1")
_original_build_command = worker.build_command


def isolated_config(**kwargs):
    values = dict(kwargs)
    values.update(
        {
            "scripts_dir": ROOT / "scripts",
            "three_d_speaker_dir": Path("/userdata/3D-Speaker"),
            "three_d_speaker_python": Path("/userdata/miniforge3/envs/3dspeaker/bin/python"),
            "asr_dir": Path("/userdata/meeting_agent/runtime/asr/qwen3_asr_gcc10/rknn_Qwen3_ASR_batch_demo"),
            "asr_model_dir": Path("/userdata/meeting_agent/models/asr/qwen3-asr-0.6b-rknn"),
            "model_dir": Path("/userdata/meeting_agent/models/llm/v104/qwen3-4b-v104-ctx16k"),
            "server": Path("/usr/bin/rkllm3-server"),
            "host": "127.0.0.1",
            "port": 18247,
        }
    )
    return BaseHarnessRunConfig(**values)


def mainline_build_command(source_audio, out_dir, config, python_executable=None):
    command = _original_build_command(source_audio, out_dir, config, python_executable)
    if len(command) >= 3 and command[1:3] == ["-m", "harness.main"]:
        command[2] = "meeting_agent.harness.main"
    return command


worker.build_command = mainline_build_command
api.DEFAULT_PORT = 18082
api.DEFAULT_DATA_ROOT = ROOT / "runtime" / "board_agent_api_v0_mainline"
api.HarnessRunConfig = isolated_config
api.DEFAULT_DATA_ROOT.mkdir(parents=True, exist_ok=True)
api.main()

