{
  "TaskId": "mtg_3d8c1ede1bc20e3e",
  "AutoChapters": [
    {
      "Id": 1,
      "Start": 36680,
      "End": 236470,
      "Headline": "会议开场与议题讨论",
      "Summary": "会议由副院长主持，各部门代表出席。上半年因疫情原因，学生在家上网课，教师反馈网课效率不高，下半年需调整教学方式。考试方式可能以网络方式进行，部分科目需返校后考试。"
    },
    {
      "Id": 2,
      "Start": 236470,
      "End": 517830,
      "Headline": "疫情期间学校运营与防疫措施",
      "Summary": "疫情期间学校未开学，导致设备维修和人员管理问题。学校主要开销为教师薪资和设备维修，安保部门裁员但仍在职人员需值班并做好防疫工作。疫情期间学校场地外租使用受限，需控制观众入场。学校计划在夏季恢复篮球场活动，但需严格防疫措施。学校需加强学生管理，包括毕业证发放和隔离措施。"
    },
    {
      "Id": 3,
      "Start": 517830,
      "End": 699790,
      "Headline": "食堂问题与承包情况讨论",
      "Summary": "会议讨论了疫情期间食堂因学生不在校导致运营困难，需定期消毒和检查卫生。食堂窗口数量减少导致收入下降，承包商可能住在学校外，需定期进出。教职工宿舍费用较高，但有部分教职工自愿入住。"
    },
    {
      "Id": 4,
      "Start": 699790,
      "End": 852270,
      "Headline": "财务与教学安排讨论",
      "Summary": "会议讨论了住宿费退一半、书费不退等财务安排，并决定将省下的水电费用用于提升教学质量。同时，学校计划用节省的经费支持教师福利，后勤部在节日期间会赠送月饼和粽子等礼品。"
    },
    {
      "Id": 5,
      "Start": 858100,
      "End": 1057945,
      "Headline": "学校后勤与安全议题讨论",
      "Summary": "会议讨论了学校就餐方式、宿舍设备检查、下半年开学准备及安全措施。重点包括使用一卡通支付、检查宿舍设备、进行消防演练，并强调宣传学校硬件设施和教育条件。"
    },
    {
      "Id": 6,
      "Start": 1055945,
      "End": 1194970,
      "Headline": "消防演习与宣传安排",
      "Summary": "会议决定安排学生出行及消防演习，并需宣传社团活动，举办社团介绍活动，开展志愿者和创新创业活动，将信息放在学校官网供报考学生了解，涉及经济预算和各部门协调。"
    },
    {
      "Id": 7,
      "Start": 1194970,
      "End": 1365795,
      "Headline": "军训安排与校园环境讨论",
      "Summary": "会议讨论了校园环境需通过航拍仪检查，并考虑将军训推迟至学期末以减少人员聚集。军训是国家规定的必修项目，必须参加，同时在军训过程中应增加互动活动，促进学生之间关系融洽，目的是锻炼学生意志和综合素质。教官来源需明确，可能从消防队等单位招募。"
    },
    {
      "Id": 8,
      "Start": 1363795,
      "End": 1540480,
      "Headline": "军训方案讨论",
      "Summary": "会议讨论了招聘退伍兵作为教官，需明确招录人数及身体条件要求，并与服装生产厂家协商制定方案。同时建议增加海军、空军等兵种内容，通过游戏和表演提升学生军训积极性。"
    },
    {
      "Id": 9,
      "Start": 1540480,
      "End": 1862276,
      "Headline": "学校专业设置与后勤安排讨论",
      "Summary": "计算机专业是热门，因涉及机赛和软件。学校提供计算机设备和实验室资源，同时统一安排考证。学校在运动会等特殊场合准备校服和医疗物资。"
    }
  ]
}
