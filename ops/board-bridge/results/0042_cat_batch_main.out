   441	    model_init_attempted = true;
   442	    ret = init_qwen3_asr_model(&app_ctx,
   443	                               llm_model_path,
   444	                               llm_weight_path,
   445	                               audio_model_path,
   446	                               audio_weight_path,
   447	                               &params,
   448	                               n_params,
   449	                               callback,
   450	                               llm_core_mask,
   451	                               audio_core_mask);
   452	    if (ret != 0)
   453	    {
   454	        fprintf(stderr, "init qwen3_asr model failed: %d\n", ret);
   455	        final_ret = 2;
   456	        goto cleanup;
   457	    }
   458	
   459	    output = fopen(results_path, append ? "ab" : "wb");
   460	    if (!output)
   461	    {
   462	        fprintf(stderr, "open results failed: %s\n", strerror(errno));
   463	        final_ret = 2;
   464	        goto cleanup;
   465	    }
   466	
   467	    for (size_t i = 0; i < jobs.size(); ++i)
   468	    {
   469	        if (g_stop_requested)
   470	        {
   471	            fprintf(stderr, "BATCH_STOP requested before job=%s\n", jobs[i].id.c_str());
   472	            final_ret = 130;
   473	            break;
   474	        }
   475	
   476	        const batch_job& job = jobs[i];
   477	        audio_buffer_t audio;
   478	        memset(&audio, 0, sizeof(audio));
   479	        float16* audio_embeds = NULL;
   480	        rknn_perf_metrics_t perf;
   481	        memset(&perf, 0, sizeof(perf));
   482	        reset_callback_context(&callback_ctx);
   483	        std::string error;
   484	        const char* status = "ok";
   485	        int64_t started = getCurrentTimeUs();
   486	        float duration = 0.0f;
   487	
   488	        fprintf(stderr, "BATCH_JOB_BEGIN index=%zu/%zu id=%s wav=%s\n",
   489	                i + 1, jobs.size(), job.id.c_str(), job.wav_path.c_str());
   490	
   491	        ret = rknn3_session_clear_kvcache(app_ctx.llm.rknn_sess, RKNN3_KVCACHE_CLEAR_ALL);
   492	        if (ret < 0)
   493	        {
   494	            status = "kvcache_clear_failed";
   495	            std::ostringstream message;
   496	            message << "rknn3_session_clear_kvcache ret=" << ret;
   497	            error = message.str();
   498	        }
   499	
   500	        if (strcmp(status, "ok") == 0)
   501	        {
   502	            ret = read_audio(job.wav_path.c_str(), &audio);
   503	            if (ret != 0)
   504	            {
   505	                status = "audio_read_failed";
   506	                std::ostringstream message;
   507	                message << "read_audio ret=" << ret;
   508	                error = message.str();
   509	            }
   510	        }
   511	
   512	        if (strcmp(status, "ok") == 0)
   513	        {
   514	            if (audio.sample_rate <= 0 || audio.num_frames < MIN_AUDIO_FRAMES)
   515	            {
   516	                status = "audio_invalid";
   517	                error = "audio is empty or shorter than one FFT window";
   518	            }
   519	            else
   520	            {
   521	                int max_frames = audio.sample_rate * OFFLINE_MAX_AUDIO_SECONDS;
   522	                if (audio.num_frames > max_frames)
   523	                {
   524	                    audio.num_frames = max_frames;
   525	                }
   526	                duration = static_cast<float>(audio.num_frames) / audio.sample_rate;
   527	            }
   528	        }
   529	
   530	        if (strcmp(status, "ok") == 0)
   531	        {
   532	            size_t n_audio_tokens = get_n_audio(&app_ctx.audio, audio.num_frames);
   533	            size_t n_embed_audio = n_audio_tokens * app_ctx.audio.embeds_shape[1];
   534	            if (n_audio_tokens == 0 || n_embed_audio == 0)
   535	            {
   536	                status = "audio_token_invalid";
   537	                error = "get_n_audio returned zero";
   538	            }
   539	            else
   540	            {
   541	                audio_embeds = static_cast<float16*>(malloc(n_embed_audio * sizeof(float16)));
   542	                if (!audio_embeds)
   543	                {
   544	                    status = "malloc_failed";
   545	                    error = "failed to allocate audio embeddings";
   546	                }
   547	                else
   548	                {
   549	                    ret = inference_qwen3_asr_model(&app_ctx, &audio, audio_embeds, n_audio_tokens, 1, &perf);
   550	                    if (ret != 0)
   551	                    {
   552	                        status = "inference_failed";
   553	                        std::ostringstream message;
   554	                        message << "inference ret=" << ret;
   555	                        error = message.str();
   556	                    }
   557	                    else if (callback_ctx.callback_error)
   558	                    {
   559	                        status = "callback_error";
   560	                        error = "LLM callback reported an error";
   561	                    }
   562	                    else if (!callback_ctx.text_started || trim_copy(callback_ctx.text).empty())
   563	                    {
   564	                        status = "transcript_empty";
   565	                        error = "ASR text marker or transcript was not produced";
   566	                    }
   567	                    else if (callback_ctx.max_new_tokens_reached)
   568	                    {
   569	                        status = "max_new_tokens";
   570	                        error = "maximum new tokens reached";
   571	                    }
   572	                }
   573	            }
   574	        }
   575	
   576	        float elapsed = static_cast<float>(getCurrentTimeUs() - started) / 1000000.0f;
   577	        write_result(output, job, status, trim_copy(callback_ctx.text), error, duration, elapsed, perf, 1);
   578	
   579	        if (audio_embeds)
   580	        {
   581	            free(audio_embeds);
   582	        }
   583	        if (audio.data)
   584	        {
   585	            free(audio.data);
   586	        }
   587	
   588	        ++completed;
   589	        if (strcmp(status, "ok") != 0)
   590	        {
   591	            ++failed;
   592	            final_ret = 1;
   593	        }
   594	        fprintf(stderr, "BATCH_JOB_END id=%s status=%s elapsed=%.3f text_chars=%zu\n",
   595	                job.id.c_str(), status, elapsed, callback_ctx.text.size());
   596	
   597	        if (strcmp(status, "ok") != 0 && stop_on_error)
   598	        {
   599	            break;
   600	        }
   601	    }
   602	
   603	cleanup:
   604	    if (output)
   605	    {
   606	        fclose(output);
   607	        output = NULL;
   608	    }
   609	    if (model_init_attempted)
   610	    {
   611	        ret = release_qwen3_asr_model(&app_ctx);
   612	        if (ret != 0)
   613	        {
   614	            fprintf(stderr, "release qwen3_asr model failed: %d\n", ret);
   615	            if (final_ret == 0)
   616	            {
   617	                final_ret = 2;
   618	            }
   619	        }
   620	    }
   621	    if (embedding_info.embedding_data)
   622	    {
   623	        munmap(static_cast<void*>(embedding_info.embedding_data), emb_st.st_size);
   624	        embedding_info.embedding_data = NULL;
   625	    }
   626	    if (embedding_info.fd != -1)
   627	    {
   628	        close(embedding_info.fd);
   629	        embedding_info.fd = -1;
   630	    }
   631	    if (tokenizer)
   632	    {
   633	        delete tokenizer;
   634	        tokenizer = NULL;
   635	    }
   636	
   637	    fprintf(stderr,
   638	            "BATCH_DONE jobs=%zu completed=%d failed=%d elapsed=%.3f exit=%d\n",
   639	            jobs.size(),
   640	            completed,
   641	            failed,
   642	            static_cast<float>(getCurrentTimeUs() - batch_started) / 1000000.0f,
   643	            final_ret);
   644	    return final_ret;
   645	}
