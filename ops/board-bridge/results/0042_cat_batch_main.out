    71	static std::string json_escape(const std::string& value)
    72	{
    73	    std::ostringstream out;
    74	    static const char hex[] = "0123456789abcdef";
    75	    for (size_t i = 0; i < value.size(); ++i)
    76	    {
    77	        unsigned char c = static_cast<unsigned char>(value[i]);
    78	        switch (c)
    79	        {
    80	            case '\"': out << "\\\""; break;
    81	            case '\\': out << "\\\\"; break;
    82	            case '\b': out << "\\b"; break;
    83	            case '\f': out << "\\f"; break;
    84	            case '\n': out << "\\n"; break;
    85	            case '\r': out << "\\r"; break;
    86	            case '\t': out << "\\t"; break;
    87	            default:
    88	                if (c < 0x20)
    89	                {
    90	                    out << "\\u00" << hex[(c >> 4) & 0x0f] << hex[c & 0x0f];
    91	                }
    92	                else
    93	                {
    94	                    out << value[i];
    95	                }
    96	        }
    97	    }
    98	    return out.str();
    99	}
   100	
   101	static std::string trim_copy(const std::string& value)
   102	{
   103	    size_t begin = value.find_first_not_of(" \t\r\n");
   104	    if (begin == std::string::npos)
   105	    {
   106	        return "";
   107	    }
   108	    size_t end = value.find_last_not_of(" \t\r\n");
   109	    return value.substr(begin, end - begin + 1);
   110	}
   111	
   112	static bool load_manifest(const char* path, std::vector<batch_job>* jobs, std::string* error)
   113	{
   114	    std::ifstream input(path);
   115	    if (!input)
   116	    {
   117	        *error = std::string("cannot open manifest: ") + path;
   118	        return false;
   119	    }
   120	
   121	    std::string line;
   122	    int line_number = 0;
   123	    while (std::getline(input, line))
   124	    {
   125	        ++line_number;
   126	        if (!line.empty() && line[line.size() - 1] == '\r')
   127	        {
   128	            line.resize(line.size() - 1);
   129	        }
   130	        if (line.empty() || line[0] == '#')
   131	        {
   132	            continue;
   133	        }
   134	
   135	        size_t tab = line.find('\t');
   136	        if (tab == std::string::npos || line.find('\t', tab + 1) != std::string::npos)
   137	        {
   138	            std::ostringstream message;
   139	            message << "manifest line " << line_number << " must contain exactly one tab";
   140	            *error = message.str();
   141	            return false;
   142	        }
   143	
   144	        batch_job job;
   145	        job.id = trim_copy(line.substr(0, tab));
   146	        job.wav_path = trim_copy(line.substr(tab + 1));
   147	        if (job.id.empty() || job.wav_path.empty())
   148	        {
   149	            std::ostringstream message;
   150	            message << "manifest line " << line_number << " has an empty field";
   151	            *error = message.str();
   152	            return false;
   153	        }
   154	
   155	        for (size_t i = 0; i < jobs->size(); ++i)
   156	        {
   157	            if ((*jobs)[i].id == job.id)
   158	            {
   159	                std::ostringstream message;
   160	                message << "duplicate job id at line " << line_number << ": " << job.id;
   161	                *error = message.str();
   162	                return false;
   163	            }
   164	        }
   165	        jobs->push_back(job);
   166	    }
   167	
   168	    if (jobs->empty())
   169	    {
   170	        *error = "manifest has no jobs";
   171	        return false;
   172	    }
   173	    return true;
   174	}
   175	
   176	static int result_callback(void* userdata, RKLLMResult* result, LLMCallState state)
   177	{
   178	    batch_callback_context* ctx = static_cast<batch_callback_context*>(userdata);
   179	    if (!ctx)
   180	    {
   181	        return -1;
   182	    }
   183	
   184	    if (state == RKLLM_RUN_ERROR)
   185	    {
   186	        ctx->callback_error = true;
   187	        return 0;
   188	    }
   189	    if (state == RKLLM_RUN_MAX_NEW_TOKEN_REACHED)
   190	    {
   191	        ctx->max_new_tokens_reached = true;
   192	        return 0;
   193	    }
   194	    if (state != RKLLM_RUN_NORMAL || !result || !result->token_ids)
   195	    {
   196	        return 0;
   197	    }
   198	
   199	    if (ctx->first_decode)
   200	    {
   201	        ctx->first_token_time = getCurrentTimeUs();
   202	        ctx->first_decode = false;
   203	    }
   204	
   205	    for (int i = 0; i < result->num_tokens; ++i)
   206	    {
   207	        int token_id = result->token_ids[i];
   208	        if (!ctx->text_started)
   209	        {
   210	            if (token_id == ASR_TEXT_TOKEN)
   211	            {
   212	                ctx->text_started = true;
   213	            }
   214	            continue;
   215	        }
   216	        ctx->text += ctx->tokenizer->TokenToPiece(token_id);
   217	    }
   218	    return 0;
   219	}
   220	
   221	static int tokenizer_callback(void* userdata, const char* text, int32_t text_len, int32_t* tokens, int32_t n_tokens_max)
   222	{
   223	    Tokenizer* tokenizer = static_cast<Tokenizer*>(userdata);
   224	    int n_tokens = tokenizer->Tokenize(text, text_len, tokens, n_tokens_max);
   225	    if (n_tokens <= 0)
   226	    {
   227	        fprintf(stderr, "tokenizer failed for %s\n", text);
   228	    }
   229	    return n_tokens;
   230	}
   231	
   232	static int embed_callback(void* userdata, int32_t* tokens, uint64_t num_tokens, void* embed, uint64_t len)
   233	{
   234	    struct embedding_info* embed_info = static_cast<struct embedding_info*>(userdata);
   235	    if (len != num_tokens * embed_info->embedding_dim * sizeof(float16))
   236	    {
   237	        fprintf(stderr, "invalid embed buffer\n");
   238	        return -1;
   239	    }
   240	
   241	    for (uint64_t n = 0; n < num_tokens; ++n)
   242	    {
   243	        int32_t token_id = tokens[n];
   244	        if (token_id < 0 || token_id >= embed_info->vocab_size)
   245	        {
   246	            fprintf(stderr, "invalid token id: %d\n", token_id);
   247	            return -1;
   248	        }
   249	        memcpy(static_cast<unsigned char*>(embed) + n * embed_info->embedding_dim * sizeof(float16),
   250	               embed_info->embedding_data + token_id * embed_info->embedding_dim,
   251	               embed_info->embedding_dim * sizeof(float16));
   252	    }
   253	    return 0;
   254	}
   255	
   256	static void reset_callback_context(batch_callback_context* ctx)
   257	{
   258	    ctx->text.clear();
   259	    ctx->text_started = false;
   260	    ctx->first_decode = true;
   261	    ctx->callback_error = false;
   262	    ctx->max_new_tokens_reached = false;
   263	    ctx->first_token_time = 0;
   264	}
   265	
   266	static void write_result(FILE* output,
   267	                         const batch_job& job,
   268	                         const char* status,
   269	                         const std::string& text,
   270	                         const std::string& error,
   271	                         float audio_duration_sec,
   272	                         float elapsed_sec,
   273	                         const rknn_perf_metrics_t& perf,
   274	                         int attempt)
   275	{
   276	    fprintf(output,
   277	            "{\"job_id\":\"%s\",\"wav_path\":\"%s\",\"status\":\"%s\","
   278	            "\"text\":\"%s\",\"error\":\"%s\",\"audio_duration_sec\":%.6f,"
   279	            "\"elapsed_sec\":%.6f,\"audio_latency_ms\":%.3f,\"llm_elapsed_ms\":%.3f,"
   280	            "\"prefill_tokens\":%d,\"decode_tokens\":%d,\"attempt\":%d}\n",
   281	            json_escape(job.id).c_str(),
   282	            json_escape(job.wav_path).c_str(),
   283	            status,
   284	            json_escape(text).c_str(),
   285	            json_escape(error).c_str(),
   286	            audio_duration_sec,
   287	            elapsed_sec,
   288	            perf.audio_latency / 1000.0,
   289	            (perf.llm_end_time > perf.llm_start_time) ? (perf.llm_end_time - perf.llm_start_time) / 1000.0 : 0.0,
   290	            perf.n_prefill_tokens,
   291	            perf.n_decode_tokens,
   292	            attempt);
   293	    fflush(output);
   294	}
