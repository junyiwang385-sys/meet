   296	static void print_usage(const char* program)
   297	{
   298	    fprintf(stderr,
   299	            "Usage: %s <audio_model_path> <audio_weight_path> <llm_model_path> <llm_weight_path> "
   300	            "<tokenizer_path> <embedding_path> <audio_core_mask> <llm_core_mask> "
   301	            "<manifest.tsv> <results.jsonl> [--append] [--stop-on-error]\n",
   302	            program);
   303	}
   304	
   305	int main(int argc, char** argv)
   306	{
   307	    if (argc < 11 || argc > 13)
   308	    {
   309	        print_usage(argv[0]);
   310	        return 2;
   311	    }
   312	
   313	    bool append = false;
   314	    bool stop_on_error = false;
   315	    for (int i = 11; i < argc; ++i)
   316	    {
   317	        if (strcmp(argv[i], "--append") == 0)
   318	        {
   319	            append = true;
   320	        }
   321	        else if (strcmp(argv[i], "--stop-on-error") == 0)
   322	        {
   323	            stop_on_error = true;
   324	        }
   325	        else
   326	        {
   327	            fprintf(stderr, "unknown option: %s\n", argv[i]);
   328	            print_usage(argv[0]);
   329	            return 2;
   330	        }
   331	    }
   332	
   333	    const char* audio_model_path = argv[1];
   334	    const char* audio_weight_path = argv[2];
   335	    const char* llm_model_path = argv[3];
   336	    const char* llm_weight_path = argv[4];
   337	    const char* tokenizer_path = argv[5];
   338	    const char* embedding_path = argv[6];
   339	    uint32_t audio_core_mask = strtoul(argv[7], NULL, 16);
   340	    uint32_t llm_core_mask = strtoul(argv[8], NULL, 16);
   341	    const char* manifest_path = argv[9];
   342	    const char* results_path = argv[10];
   343	
   344	    std::vector<batch_job> jobs;
   345	    std::string manifest_error;
   346	    if (!load_manifest(manifest_path, &jobs, &manifest_error))
   347	    {
   348	        fprintf(stderr, "manifest error: %s\n", manifest_error.c_str());
   349	        return 2;
   350	    }
   351	
   352	    signal(SIGINT, on_signal);
   353	    signal(SIGTERM, on_signal);
   354	
   355	    int ret = 0;
   356	    int final_ret = 0;
   357	    int failed = 0;
   358	    int completed = 0;
   359	    int64_t batch_started = getCurrentTimeUs();
   360	
   361	    rknn_app_context_t app_ctx;
   362	    memset(&app_ctx, 0, sizeof(app_ctx));
   363	    bool model_init_attempted = false;
   364	
   365	    Tokenizer* tokenizer = NULL;
   366	    VocabInfo vocab_info;
   367	    memset(&vocab_info, 0, sizeof(vocab_info));
   368	
   369	    struct embedding_info embedding_info;
   370	    memset(&embedding_info, 0, sizeof(embedding_info));
   371	    embedding_info.fd = -1;
   372	    embedding_info.embedding_data = NULL;
   373	    struct stat emb_st;
   374	    memset(&emb_st, 0, sizeof(emb_st));
   375	
   376	    FILE* output = NULL;
   377	    batch_callback_context callback_ctx;
   378	    callback_ctx.tokenizer = NULL;
   379	    reset_callback_context(&callback_ctx);
   380	
   381	    int n_params = 1;
   382	    rknn3_llm_param params;
   383	    memset(&params, 0, sizeof(params));
   384	    RKLLMCallback callback;
   385	    memset(&callback, 0, sizeof(callback));
   386	
   387	    tokenizer = new Tokenizer(TOKENIZER_BACKEND_LLAMA, tokenizer_path);
   388	    if (!tokenizer)
   389	    {
   390	        fprintf(stderr, "load tokenizer failed: %s\n", tokenizer_path);
   391	        final_ret = 2;
   392	        goto cleanup;
   393	    }
   394	    tokenizer->GetVocabInfo(&vocab_info);
   395	
   396	    embedding_info.fd = open(embedding_path, O_RDONLY);
   397	    if (embedding_info.fd == -1)
   398	    {
   399	        fprintf(stderr, "open embedding failed: %s\n", strerror(errno));
   400	        final_ret = 2;
   401	        goto cleanup;
   402	    }
   403	    if (fstat(embedding_info.fd, &emb_st) == -1)
   404	    {
   405	        fprintf(stderr, "fstat embedding failed: %s\n", strerror(errno));
   406	        final_ret = 2;
   407	        goto cleanup;
   408	    }
   409	    embedding_info.embedding_data = static_cast<float16*>(mmap(NULL, emb_st.st_size, PROT_READ, MAP_PRIVATE, embedding_info.fd, 0));
   410	    if (embedding_info.embedding_data == MAP_FAILED)
   411	    {
   412	        embedding_info.embedding_data = NULL;
   413	        fprintf(stderr, "mmap embedding failed: %s\n", strerror(errno));
   414	        final_ret = 2;
   415	        goto cleanup;
   416	    }
   417	    embedding_info.vocab_size = vocab_info.vocab_size;
   418	    embedding_info.embedding_dim = (emb_st.st_size / vocab_info.vocab_size) / sizeof(float16);
   419	
